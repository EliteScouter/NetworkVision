# =============================================================================
# NetworkVision configuration (native install)
#
# Linux:   /etc/networkvision/networkvision.env   then: sudo systemctl restart networkvision
# Windows: %ProgramData%\NetworkVision\networkvision.env   then restart the
#          "NetworkVision" service (services.msc, or: Restart-Service NetworkVision)
#
# Every option from the Docker setup works here too; the full documented list is
# .env.example in the repository. Real environment variables override this file.
# This file is not overwritten on upgrade.
# =============================================================================

# Web UI
NV_HOST=0.0.0.0
NV_PORT=8080

# Syslog receiver (UDP + TCP). 514 is the standard port; on Linux the service
# has CAP_NET_BIND_SERVICE so it can bind it without running as root.
NV_SYSLOG_PORT=514

# Admin login: leave these empty to create the admin account in the browser on
# first visit. Setting them here takes precedence over the account made in the
# UI (handy if you ever forget that password).
#NV_ADMIN_USERNAME=admin
#NV_ADMIN_PASSWORD=
#NV_ADMIN_PASSWORD_HASH=

# Set true when served over HTTPS (reverse proxy) so cookies are Secure.
NV_COOKIE_SECURE=false

# Signs sessions and encrypts stored device credentials. Leave empty: a random
# key is generated on first start and kept in the data directory (.secret_key).
# Back that file up together with the database.
#NV_SECRET_KEY=

# Database: SQLite in the data directory by default, or MariaDB/MySQL.
#NV_DB_DRIVER=mariadb
#NV_DB_HOST=
#NV_DB_NAME=networkvision
#NV_DB_USER=networkvision
#NV_DB_PASSWORD=

# Notifications (optional)
#NV_NOTIFY_DISCORD_WEBHOOK_URL=
#NV_NOTIFY_NTFY_URL=

# Device credentials: in the UI enter a secret as env:NAME and it is read from
# this file (or the environment) instead of being stored in the database.
#PFSENSE_API_KEY=
#UNIFI_PASSWORD=
