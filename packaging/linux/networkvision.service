[Unit]
Description=NetworkVision network monitoring dashboard
Documentation=https://github.com/EliteScouter/NetworkVision
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=networkvision
Group=networkvision
# Settings come from /etc/networkvision/networkvision.env (read by the app itself);
# data lives in /var/lib/networkvision.
WorkingDirectory=/var/lib/networkvision
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 NV_STATIC_DIR=/opt/networkvision/static
# The unit grants CAP_NET_RAW, so use raw ICMP sockets (works regardless of ping_group_range).
Environment=NV_PING_PRIVILEGED=true
ExecStart=/opt/networkvision/venv/bin/python -m app
Restart=on-failure
RestartSec=5

# Bind syslog on 514 and send ICMP pings without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
StateDirectory=networkvision
StateDirectoryMode=0750
ReadWritePaths=/var/lib/networkvision

[Install]
WantedBy=multi-user.target
