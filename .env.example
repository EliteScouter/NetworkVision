# =============================================================================
# NetworkVision configuration
# Copy to .env (local) or paste into Portainer's stack "Environment variables".
# NEVER commit your real .env - it is git-ignored.
# =============================================================================

# --- Required ----------------------------------------------------------------
# Signs sessions and encrypts stored device credentials. Generate with:
#   openssl rand -base64 48
# Changing it later invalidates sessions and credentials saved in the UI.
NV_SECRET_KEY=

# Dashboard login. Prefer a bcrypt hash:
#   docker run --rm python:3.13-slim sh -c "pip -q install bcrypt && python -c \"import bcrypt,getpass;print(bcrypt.hashpw(getpass.getpass().encode(),bcrypt.gensalt()).decode())\""
NV_ADMIN_USERNAME=admin
NV_ADMIN_PASSWORD=
NV_ADMIN_PASSWORD_HASH=

# Set true when served over HTTPS (reverse proxy) so cookies are Secure.
NV_COOKIE_SECURE=false
# Behind Authelia/Authentik/etc? Trust this header as the logged-in user.
# Only enable if the port is NOT reachable except through the proxy.
NV_TRUSTED_PROXY_HEADER=
NV_AUTH_DISABLED=false

# --- Two-factor authentication -----------------------------------------------
# Easiest: enable it in the UI (Integrations > Security) with any authenticator app.
# Or pin the TOTP secret (base32) here; MFA is then always on and UI-managed MFA is off.
NV_ADMIN_TOTP_SECRET=
# Break-glass: true clears UI-enrolled MFA on startup (lost phone + lost codes). Unset it afterwards!
NV_MFA_RESET=false

# --- KeePass secret provider (optional) --------------------------------------
# Reference entries in any credential field: kp:Group/Entry, kp:Group/Entry#username,
# kp:Group/Entry#custom_field. Use a DEDICATED .kdbx with only NetworkVision's creds,
# mounted read-only. It is re-read automatically when it changes.
NV_KEEPASS_FILE=
NV_KEEPASS_PASSWORD=
NV_KEEPASS_KEYFILE=

# --- General -----------------------------------------------------------------
# true = seed a simulated homelab (great for trying it out)
NV_DEMO_MODE=false
# seconds between polls (per device override in UI)
NV_POLL_INTERVAL=15
NV_LOG_LEVEL=INFO
# host port for the web UI (compose only)
NV_HTTP_PORT=8080
# host port for syslog (compose only)
NV_SYSLOG_HOST_PORT=514

# --- Database ----------------------------------------------------------------
# sqlite (default, zero setup, stored in the /data volume) or mariadb
NV_DB_DRIVER=sqlite
NV_DB_HOST=
NV_DB_PORT=3306
NV_DB_NAME=networkvision
NV_DB_USER=networkvision
NV_DB_PASSWORD=
# Or a full SQLAlchemy URL (overrides the above):
# NV_DATABASE_URL=mysql+aiomysql://user:pass@host:3306/networkvision?charset=utf8mb4

# raw per-minute samples
NV_RETENTION_DAYS_METRICS=7
# hourly rollups that power 30-day / 1-year charts
NV_RETENTION_DAYS_ROLLUP=365
NV_RETENTION_DAYS_LOGS=14
NV_RETENTION_DAYS_ALERTS=90

# --- Firewall log explorer (pfSense / OPNsense filterlog via syslog or API) ---
NV_FIREWALL_ENABLED=true
NV_RETENTION_DAYS_FIREWALL=7
# Busy firewalls: count pass traffic / multicast + IPv6 link-local chatter but do not store each row
NV_FIREWALL_STORE_PASS=true
NV_FIREWALL_STORE_NOISE=true
# false = filterlog lines only go to the Firewall page, not also to Logs (avoids storing every line twice)
NV_FIREWALL_KEEP_RAW_LOGS=true

# --- Alert thresholds --------------------------------------------------------
NV_ALERT_CPU_PCT=90
NV_ALERT_MEM_PCT=92
NV_ALERT_TEMP_C=80
NV_ALERT_LATENCY_MS=150
NV_ALERT_LOSS_PCT=10
NV_ALERT_IF_UTIL_PCT=90
NV_ALERT_IF_ERRORS_PER_MIN=50
# polls a condition must persist before alerting
NV_ALERT_CONSECUTIVE=3

# --- Notifications (all optional) --------------------------------------------
# info | warning | critical
NV_NOTIFY_MIN_SEVERITY=warning
NV_NOTIFY_DISCORD_WEBHOOK_URL=
NV_NOTIFY_SLACK_WEBHOOK_URL=
# e.g. https://ntfy.sh/your-topic
NV_NOTIFY_NTFY_URL=
NV_NOTIFY_NTFY_TOKEN=
# generic JSON POST
NV_NOTIFY_WEBHOOK_URL=

# --- Device credentials ------------------------------------------------------
# In the UI, enter secrets as env:NAME to read them from here instead of
# storing them in the database. Any name works except NV_* (blocked).
PFSENSE_API_KEY=
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_API_KEY=
SNMP_COMMUNITY=
TPLINK_PASSWORD=
